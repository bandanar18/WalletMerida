# API de la Lotería a la que se conecta la Wallet (el servidor de desarrollo reenvía /api ahí).
LOTERIA_API_URL=http://localhost:3000
# Dirección pública de la web de la Lotería: el QR y el enlace de la agencia apuntan a <url>/r/<código>.
VITE_LOTERIA_URL=http://localhost:5173
# Solo desarrollo: carpeta del .env de la API de la Lotería, para los accesos rápidos de prueba.
LOTERIA_API_ENV_DIR=../Loteria/apps/api
